# Python and tooling
.venv/
__pycache__/
*.pyc
.DS_Store

# Someone else's video material never leaves the machine
**/reference/private/

# Render scratch folders
**/edit/work/
**/edit/preview/work/

# Secrets, in case one is ever dropped here by mistake
.env
.env.*
!.env.example
*.pem
*.key

# Example masters that are rebuilt rather than stored (the README of each example says which)
examples/gym-breakup/final/*-4x5.mp4
examples/gym-breakup/final/*-1x1.mp4
examples/gym-breakup/final/*-16x9.mp4
examples/gym-breakup-gpu/final/*.mp4
