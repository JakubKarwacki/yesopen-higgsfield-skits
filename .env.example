# Names of the variables the container reads. Only a template: NO values here and no local .env.
# The values live in GitHub Secrets of the private secrets repo (yesopen-higgsfield-secrets) and reach the container from
# the in-memory sidecar (scripts\skill.ps1 unlock). docker-compose.yml passes these names through.
# Never create a .env with real values: keys are never kept locally or in an image.
#
# set once (prompts for the value, nothing is written to disk):
#   gh secret set <NAME> --env broker --repo <owner>/<secrets-repo>
VERDA_CLIENT_ID=
VERDA_CLIENT_SECRET=
# GPU SSH key: one line with \n for line breaks, or base64 of the whole key file
YESOPEN_GPU_SSH_KEY=
YESOPEN_GPU_SSH_KEY_PUB=
