#!/usr/bin/env bash
# Launcher for hf_job.py (Higgsfield platform API). The key comes from HF_KEY if it is already
# set, otherwise from the macOS Keychain (service "higgsfield", account "api-key"), and is exported
# only into the child Python process. It is never printed, logged or written to a file.
#
# Python: $HF_PYTHON, else this skill's .venv, else the higgsfield-generate skill's .venv;
# if none exists, a .venv with higgsfield-client is created next to this skill.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
SKILL="$(dirname "$HERE")"
PY="${HF_PYTHON:-}"
if [ -z "$PY" ]; then
  for candidate in "$SKILL/.venv/bin/python" "$HOME/.agents/skills/higgsfield-generate/.venv/bin/python"; do
    if [ -x "$candidate" ]; then PY="$candidate"; break; fi
  done
fi
if [ -z "$PY" ]; then
  python3 -m venv "$SKILL/.venv"
  "$SKILL/.venv/bin/pip" install -q higgsfield-client
  PY="$SKILL/.venv/bin/python"
fi
if [ "${1:-}" != "cost" ]; then
  if [ -z "${HF_KEY:-}" ] && command -v security >/dev/null 2>&1; then
    HF_KEY="$(security find-generic-password -s higgsfield -a api-key -w 2>/dev/null || true)"
  fi
  if [ -z "${HF_KEY:-}" ]; then
    echo "No Higgsfield key. Store it once (it asks for the key without echoing it):" >&2
    echo "  security add-generic-password -U -s higgsfield -a api-key -w" >&2
    exit 2
  fi
  export HF_KEY
fi
exec "$PY" "$HERE/hf_job.py" "$@"
