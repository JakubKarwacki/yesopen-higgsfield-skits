{
  "template": "h3-talk",
  "doc": "Variant B, only with MiniMax's consent: lip-synced take from a still and a recorded line (MiniMax H3). The line is anchored as the soundtrack, so the voice stays ours.",
  "params": {
    "image": {
      "type": "image",
      "targets": [
        [
          "114",
          "image"
        ]
      ],
      "required": true
    },
    "audio": {
      "type": "audio",
      "targets": [
        [
          "901",
          "audio"
        ]
      ],
      "required": true,
      "doc": "padded with silence to the shot length before upload"
    },
    "prompt": {
      "type": "text",
      "targets": [
        [
          "105:104",
          "prompt"
        ]
      ],
      "required": true
    },
    "aspect": {
      "type": "enum",
      "targets": [
        [
          "115",
          "aspect_ratio"
        ]
      ],
      "default": "9:16 (Portrait Widescreen)"
    },
    "megapixels": {
      "type": "float",
      "targets": [
        [
          "115",
          "megapixels"
        ]
      ],
      "default": 0.98,
      "doc": "0.98 = 768x1344 at 9:16, the model's largest trained canvas (the template's 0.4 gives 480x864)"
    },
    "seconds": {
      "type": "float",
      "targets": [
        [
          "105:111",
          "value"
        ]
      ],
      "required": true
    },
    "fast": {
      "type": "bool",
      "targets": [
        [
          "105:126",
          "value"
        ]
      ],
      "doc": "8-step turbo LoRA instead of 20 steps"
    },
    "seed": {
      "type": "seed",
      "targets": [
        [
          "105:15",
          "noise_seed"
        ]
      ]
    }
  },
  "outputs": {
    "video": "92"
  },
  "rules": {
    "h3_frames": {
      "seconds": "seconds",
      "pad_audio": [
        "audio"
      ]
    }
  }
}
