      "targets": [
        [
          "1",
          "exaggeration"
        ]
      ]
    },
    "cfg_weight": {
      "type": "float",
      "targets": [
        [
          "1",
          "cfg_weight"
        ]
      ]
    },
    "temperature": {
      "type": "float",
      "targets": [
        [
          "1",
          "temperature"
        ]
      ]
